# --- Required ---
# Postgres connection string (Vercel → Storage → Neon gives you this automatically)
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Long random string used to sign login sessions:  openssl rand -base64 32
AUTH_SECRET=
# Vercel Blob token for photo/video uploads (Vercel → Storage → Blob sets this automatically)
BLOB_READ_WRITE_TOKEN=

# --- Reminders ---
# Protects /api/cron/reminders. Vercel Cron sends it automatically when this variable is set.
CRON_SECRET=
# How often pending costing approvals re-notify approvers (minutes, default 30)
APPROVAL_REMINDER_MINUTES=30

# --- Push notifications (phones & desktops) ---
# Optional: if not set, keys are generated automatically and stored in the database.
# To use your own, generate with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:it@yourcompany.com

# --- PONGS CRM integration ---
# Key the CRM sends in the x-api-key header
CRM_API_KEY=
# Where approval decisions are POSTed when the CRM request had no callbackUrl
CRM_WEBHOOK_URL=
# Signs those callbacks (x-pongs-signature: sha256=<hmac>)
CRM_WEBHOOK_SECRET=
# Group a CRM approval lands in when the CRM does not say (sales | project | accounts | dispatch)
CRM_DEFAULT_DEPARTMENT=sales

# Max upload size per file in MB (default 200)
MAX_UPLOAD_MB=200

# Public address used in share links and link previews (optional; defaults to the Vercel production domain)
APP_URL=
